---
# Reviewed check selection. Enabled diagnostics are errors in the tidy presets;
# see cmake/StaticAnalysis.cmake. Expand deliberately, not indiscriminately.
#
# `#pragma once` is the convention throughout this project and is supported by
# every compiler it is built with. Include guards would add noise to 40 headers
# without making any supported build work that does not already, so
# portability-avoid-pragma-once is disabled. Keep comments outside the folded
# scalar below: inside it YAML folds them into the check list, where they
# swallow the entry that follows them.
Checks: >
  -*,
  clang-analyzer-*,
  bugprone-*,
  performance-*,
  portability-*,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-use-using,
  modernize-use-equals-default,
  modernize-use-equals-delete,
  modernize-loop-convert,
  modernize-make-unique,
  modernize-redundant-void-arg,
  misc-unused-using-decls,
  misc-misplaced-const,
  readability-redundant-member-init,
  -bugprone-easily-swappable-parameters,
  -bugprone-exception-escape,
  -performance-enum-size,
  -portability-avoid-pragma-once

# Analyse owned headers through their translation units. Dependency headers are
# treated as system headers by the compile command and are excluded here too.
HeaderFilterRegex: '.*/(src|tests)/.*\.(h|hpp)$'

# Analysis builds never apply fixes; reviewed local fix runs are a separate step.
FormatStyle: file
WarningsAsErrors: ''

CheckOptions:
  - key: bugprone-argument-comment.StrictMode
    value: '0'
  - key: performance-unnecessary-value-param.AllowedTypes
    value: 'QString;QStringList;QByteArray;QVariant;QImage;QPixmap'
  - key: modernize-use-override.IgnoreDestructors
    value: '0'
